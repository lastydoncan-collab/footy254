# Copy this file to .env, then add your API-Football key.
# Keep .env private; server.mjs reads it and never sends the key to browsers.
APISPORTS_KEY=
PORT=4173

# The paper wallet and bet history live in a local SQLite file at
# data/pitchiq.db (created automatically). Delete that file to reset
# every demo wallet back to zero bets.

# Real-money betting is intentionally not configurable in this demo.
# A licensed sportsbook operator API and approved production controls are required.
