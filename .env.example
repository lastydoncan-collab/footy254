# ============================================================
# FOOTY254 configuration.  Copy to .env and fill in.
# Never commit .env.
# ============================================================

# development | production
APP_ENV=development

# --- Database (PostgreSQL) -----------------------------------
FOOTY254_DB_NAME=footy254
FOOTY254_DB_USER=postgres
FOOTY254_DB_PASSWORD=change-this-database-password
FOOTY254_DB_HOST=localhost
FOOTY254_DB_PORT=5432
# disable | allow | prefer | require   (use "require" for managed/remote databases)
FOOTY254_DB_SSLMODE=prefer

# --- Authentication ------------------------------------------
# REQUIRED. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# In production it must be 32+ random characters or the server refuses to start.
JWT_SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Public address ------------------------------------------
# The URL users open. Used in password-reset emails.
FRONTEND_URL=http://localhost:8000

# Cookies. In production (https) leave COOKIE_SECURE unset: it defaults to true.
# Set COOKIE_SECURE=false ONLY to test over plain http on a LAN/IP address.
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax

# Only if the frontend is hosted on a DIFFERENT domain than the API
# (not needed for the default single-origin deployment):
# FRONTEND_ORIGINS=https://app.example.com
# (then also set COOKIE_SAMESITE=none and COOKIE_SECURE=true)

# --- Football data (football-data.org) -----------------------
FOOTBALL_API_KEY=

# --- Email (password reset). Without these, reset links are only logged
#     (development) - production needs a real SMTP account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=no-reply@footy254.com

# --- M-Pesa (Safaricom Daraja) -------------------------------
# sandbox | production
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Till (Buy Goods) only: set MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline,
# MPESA_SHORTCODE=<store/head-office number> and MPESA_PARTY_B=<Till number>.
# MPESA_PARTY_B=
# 32+ random characters (generate like JWT_SECRET_KEY). It is part of the callback URL.
MPESA_CALLBACK_SECRET=
# Public https URL Safaricom can reach; {secret} is replaced automatically.
# (The older /mpesa/callback/{secret} path without /api keeps working too.)
MPESA_CALLBACK_URL=https://your-domain.example/api/mpesa/callback/{secret}

# --- Runtime tuning (all optional) ---------------------------
# WEB_CONCURRENCY=2          # uvicorn workers (Docker)
# DB_POOL_MAX=15             # connections per worker; keep workers x pool < Postgres max_connections
# ENABLE_SCHEDULER=true      # background sync/retrain/expiry jobs
# ENABLE_DOCS=false          # Swagger UI at /api/docs (default: on in development only)
# RUN_MIGRATIONS_ON_STARTUP=true

# --- Card payments (Paystack hosted checkout; supports Kenya / KES) ------
# Leave PAYSTACK_SECRET_KEY empty to keep card payments switched off.
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=KES
# Frontend page Paystack returns the customer to (must be https in production).
PAYSTACK_RETURN_URL=https://your-domain.example/subscription/card-return
# In the Paystack dashboard set the webhook URL to:
#   https://your-domain.example/api/card/webhook
